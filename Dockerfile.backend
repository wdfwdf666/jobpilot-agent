# JobPilot 后端镜像（nginx 形态）。
#
# 与单容器版（Dockerfile）的差别：
#   1. 没有 node 构建阶段：前端由 frontend/Dockerfile 单独构建成 nginx 镜像；
#   2. 不拷贝 frontend/dist：静态资源不经 FastAPI，app/main.py 里那段
#      StaticFiles 挂载检测不到目录会自动跳过，所以后端代码一个字都不用改。
#
# 单独构建：docker build -f Dockerfile.backend -t jobpilot-api .
# 正常用法是交给 docker compose 编排（见 docker-compose.yml），它不对外暴露端口。

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# 依赖层单独缓存：只改业务代码时不会重装 chromadb / pymupdf 这些大包。
# --mount=type=cache 让 pip 下载缓存跨构建复用（缓存挂载不进镜像层，不增体积），
# 因此这里刻意不设 PIP_NO_CACHE_DIR。
COPY pyproject.toml ./
COPY app/ ./app/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install .

# 自检脚本一并带上：容器里也能跑 check_llm / check_rag，排障不用另起环境
COPY scripts/ ./scripts/

# 非 root 运行。顺序有坑——必须先建目录、先 chown、再切用户：
# 命名卷首次创建时继承镜像里挂载点的属主，若先切用户再 mkdir，
# 卷会变成 root 属主，运行期写向量库直接 PermissionError。
RUN useradd --create-home --uid 10001 appuser \
 && mkdir -p data/chroma data/uploads \
 && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# /health 会带上 warmup 报告，能直接看出向量库有没有起来。
# start-period 给足 40s：chroma 首次初始化 + embedding 客户端预热都在启动阶段。
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status == 200 else 1)"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
