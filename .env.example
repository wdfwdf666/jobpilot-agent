# ===== Qwen LLM（阿里云百炼 DashScope，OpenAI 兼容接口）=====
# API Key 申请：https://bailian.console.aliyun.com/ -> API-KEY 管理
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：qwen-plus（均衡，推荐）/ qwen-flash（便宜快）/ qwen3-max（旗舰）
LLM_MODEL=qwen-plus

# ===== Qwen Embedding（同为百炼，一份 Key 通用）=====
# text-embedding-v4：Qwen3-Embedding 系列，默认 1024 维，单批最多 10 条
EMBED_API_KEY=sk-xxx
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v4
EMBED_DIMENSIONS=1024

# 思考模式（Qwen3 系列混合思考模型）：留空=不传该参数，用模型默认
# 注意：思考模式与 JSON 结构化输出互斥，抽取类任务请保持关闭
LLM_ENABLE_THINKING=

# ===== 联网搜索工具（P1，暂时可留空）=====
# 默认博查 BochaAI（国内，注册送 2000 次，之后 ¥3.6/千次）
# 申请：https://open.bochaai.com -> API Key
SEARCH_PROVIDER=bocha
BOCHA_API_KEY=
# 可选兜底：切 SEARCH_PROVIDER=tavily 后生效（https://tavily.com，免费 1000 次/月）
TAVILY_API_KEY=

# ===== 跨域白名单（逗号分隔）=====
# 只影响开发环境：生产两种形态（nginx 反代 / 单容器）前后端都同源，浏览器不发跨域请求。
# 留空 = 不放行任何跨域来源；不要把这里写成 *。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 部署（仅 nginx 形态 docker compose 读取）=====
# 对外端口，映射到 web 容器的 80。默认 8080，避开本地开发的 5173 / 8000。
APP_PORT=8080

# ===== 存储路径 =====
CHROMA_DIR=data/chroma
UPLOADS_DIR=data/uploads
COLLECTION_NAME=jobpilot

# ===== LangGraph 检查点（人工审核 interrupt / resume 的前提）=====
# 图状态与对话历史落在这个 SQLite 文件里，按 thread_id（= session_id）取回。
# 不配也能跑：用默认路径。注意别提交进仓库（已加 .gitignore），里面可能有用户输入原文。
CHECKPOINT_DB=data/checkpoints.sqlite
# JD 分析后是否停在人工审核节点等确认；设 false 即退化为全自动（老行为）
HUMAN_REVIEW_JD=true
